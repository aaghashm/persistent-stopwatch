_arguments \
    '--start[start or resume the stopwatch]' \
    '--pause[pause the stopwatch]' \
    '--lap[record a lap]' \
    '--reset[reset to zero and clear the laps]' \
    '--status[print the state and elapsed time]' \
    '(- *)'{-h,--help}'[show help]' \
    '(- *)'{-v,--version}'[show version]'

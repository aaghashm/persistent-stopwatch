pkgname=persistent-stopwatch
pkgver=1.0.0
pkgrel=1
pkgdesc='Stopwatch that survives reboots'
arch=(x86_64 aarch64)
url='https://github.com/aaghashm/persistent-stopwatch'
license=('GPL-2.0-or-later AND BSD-3-Clause AND MIT AND CC0-1.0')
depends=(glibc libstdc++ hicolor-icon-theme kconfig kcoreaddons kcrash kdbusaddons ki18n kirigami kwindowsystem qt6-base qt6-declarative)
makedepends=(extra-cmake-modules git)
optdepends=('qqc2-desktop-style: native Plasma look and feel')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cmake -B build -S $pkgname \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=None \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # GPL is in Arch's common licenses; the build files and metadata use
  # BSD-3-Clause, MIT and CC0, which must ship with the package.
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" $pkgname/LICENSES/{BSD-3-Clause,MIT,CC0-1.0}.txt
}

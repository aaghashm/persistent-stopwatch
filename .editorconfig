root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,xml,spec}]
indent_size = 2

[PKGBUILD]
indent_size = 2

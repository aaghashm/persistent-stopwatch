[Desktop Entry]
Name=Persistent Stopwatch
GenericName=Stopwatch
Comment=Stopwatch that keeps counting across restarts and reboots
Exec=persistent-stopwatch
Icon=io.github.aaghashm.persistentstopwatch
Type=Application
Terminal=false
StartupNotify=true
SingleMainWindow=true
Categories=Qt;KDE;Utility;
Keywords=stopwatch;timer;chronometer;lap;
Actions=Toggle;Lap;Reset;

[Desktop Action Toggle]
Name=Start or Pause
Exec=persistent-stopwatch --toggle

[Desktop Action Lap]
Name=Lap
Exec=persistent-stopwatch --lap

[Desktop Action Reset]
Name=Reset
Exec=persistent-stopwatch --reset
